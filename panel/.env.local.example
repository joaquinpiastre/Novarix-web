DATABASE_URL=postgresql://user:password@host:port/railway
ENCRYPTION_KEY=
SESSION_SECRET=

# Bucket de archivos (adjuntos de tickets, reportes, archivos compartidos).
# En Railway son "reference variables" apuntando al bucket del proyecto
# (nunca se escriben a mano); para desarrollo local, correlas con
# `railway run npm run dev` para que Railway las resuelva, o pegá las
# credenciales de un bucket S3-compatible propio.
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=
BUCKET_NAME=

# Opcionales -- sin estas, Sentry/Resend/IA quedan inactivos (no rompe nada)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
# Asistente de IA y botones "Generar con IA" (console.anthropic.com)
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude (por defecto claude-opus-5-5)
ANTHROPIC_MODEL=

# ===== Radar viral (todas opcionales; sin ellas el proveedor queda apagado) =====
# YouTube Data API v3 (Google Cloud Console > APIs > YouTube Data API v3 > Credenciales > Clave de API)
YOUTUBE_API_KEY=
# Tope propio de búsquedas por día (Google permite 100 search.list por día)
YOUTUBE_SEARCH_DAILY_CAP=90
# Instagram para el Radar: token de Meta (ideal: de usuario del sistema) de la
# cuenta de Instagram profesional desde la que se busca. Permisos: instagram_basic,
# instagram_manage_insights, pages_read_engagement, pages_show_list (+ business_management).
TRENDS_IG_ACCESS_TOKEN=
# Alternativa: id de una conexión de Meta cargada en el panel (meta_connections)
TRENDS_IG_CONNECTION_ID=
# Opcional: id de la cuenta de Instagram Business (si no, se toma el activo instagram de esa conexión)
TRENDS_IG_USER_ID=
# "on" solo cuando Meta apruebe "Instagram Public Content Access" (App Review)
TRENDS_IG_HASHTAG_SEARCH=off
# TikTok: "manual" (links pegados a mano) o "apify" (terceros, ver riesgos en ARCHITECTURE.md)
TRENDS_TIKTOK_PROVIDER=manual
APIFY_TOKEN=
# Datos de ejemplo para desarrollo (nunca en producción)
TRENDS_MOCK_PROVIDER=off
# Opcional: versión de la Graph API de Meta (por defecto v26.0)
META_GRAPH_VERSION=
